# Supabase project (Settings → API). Public values; safe for the browser.
NEXT_PUBLIC_SUPABASE_URL=
# Anon / publishable key
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Service role key — SERVER ONLY. Never prefix with NEXT_PUBLIC_. Optional: enables citizen photo upload.
SUPABASE_SERVICE_ROLE_KEY=
# Public site URL used for metadata, sitemap and robots (e.g. https://marga-mulya-hub.vercel.app)
NEXT_PUBLIC_SITE_URL=http://localhost:3000
